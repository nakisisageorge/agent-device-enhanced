/**
 * A structural problem found in a graph by {@link getGraphIssues}.
 */
interface GraphIssue {
  /** Stable machine-readable code, e.g. `'duplicate-node-id'`. */
  code: string;
  /** What is wrong, which entity is affected, and how to fix it. */
