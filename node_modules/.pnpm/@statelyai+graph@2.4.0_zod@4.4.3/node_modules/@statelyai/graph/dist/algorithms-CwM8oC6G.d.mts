//#region src/algorithms/tsp.d.ts
/** Result of a TSP tour approximation. */
interface TSPTour {
  /** Node ids in visiting order; the tour returns to `path[0]` (not repeated). */
  path: string[];
  /** Total weight of the closed tour, using the metric closure. */
  cost: number;
}
/** Options for {@link getTSPTour}. */
interface TSPOptions<TEdgeData = any> {
  /**
   * `'greedy'` (default) — nearest-neighbor construction.
   * `'2opt'` — nearest-neighbor followed by bounded 2-opt improvement.
   */
  method?: 'greedy' | '2opt';
  /** Node id to start the tour from. Default: first node. */
  from?: string;
  /** Edge weight function. Default: `(e) => e.weight ?? 1`. */
  getWeight?: (edge: GraphEdge<TEdgeData>) => number;
}
/**
 * Approximate a shortest closed tour visiting every node exactly once
 * (Travelling Salesman Problem) on a weighted, undirected graph.
 *
 * The graph need not be complete: missing pairwise distances are filled in via
 * the **metric closure** (all-pairs shortest-path distances), matching
 * networkx's `traveling_salesman_problem`. Edges are treated as undirected.
 *
 * Construction is nearest-neighbor (`'greedy'`); `'2opt'` additionally runs a
 * bounded 2-opt local search that never increases the tour cost, so its result
 * is always ≤ the greedy result.
 *
 * @returns `{ path, cost }`, or `undefined` if the graph is not connected
 *   (no finite tour exists) — a single-node graph returns a zero-cost tour.
 */
declare function getTSPTour<N, E>(graph: Graph<N, E>, options?: TSPOptions<E>): TSPTour | undefined;
//#endregion
//#region src/algorithms/steiner.d.ts
/** Options for {@link getSteinerTree}. */
interface SteinerTreeOptions<TEdgeData = any> {
  /** Node ids that must be connected by the tree (the *terminals*). */
  terminals: string[];
  /** Edge weight function. Default: `(e) => e.weight ?? 1`. */
  getWeight?: (edge: GraphEdge<TEdgeData>) => number;
}
/**
 * Approximate a minimum-weight Steiner tree: a connected subgraph spanning all
 * `terminals`, possibly using extra ("Steiner") non-terminal nodes, of near
 * minimum total edge weight. Edges are treated as undirected.
 *
 * Uses the classic **metric-closure 2-approximation** (Kou–Markowsky–Berman,
 * the default in networkx's `steiner_tree`):
 * 1. Build the complete graph over the terminals, weighting each terminal pair
 *    by their shortest-path distance in the original graph.
 * 2. Take a minimum spanning tree of that metric closure.
 * 3. Expand each MST edge back into the underlying shortest path.
 * 4. Take an MST of the resulting subgraph and prune non-terminal leaves.
 *
 * The total weight is guaranteed within `2·(1 − 1/ℓ)` of optimal, where ℓ is
 * the number of terminal leaves.
 *
 * @returns a subgraph {@link Graph} (same shape as {@link getMinimumSpanningTree}):
 *   a fresh graph containing exactly the Steiner-tree nodes and edges. A graph
 *   with fewer than two reachable terminals yields an edge-less graph (a single
 *   terminal needs no edges).
 * @throws if a terminal id is not present in the graph, or if the terminals are
 *   not all mutually reachable (no Steiner tree exists).
 */
declare function getSteinerTree<N, E>(graph: Graph<N, E>, options: SteinerTreeOptions<E>): Graph<N, E>;
