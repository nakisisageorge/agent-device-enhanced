{
  "name": "@agent-device/ai-selector",
  "version": "0.1.0",
  "description": "AI-powered resilient selector generation for mobile app automation. Analyzes accessibility snapshots and generates robust selectors using LLM with confidence scoring and fallback chains.",
  "license": "MIT",
  "author": "George Nakisisa <nakisisageorge@gmail.com>",
  "homepage": "https://github.com/nakisisageorge/agent-device-enhanced",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakisisageorge/agent-device-enhanced.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./strategies": {
      "types": "./dist/src/strategies.d.ts",
      "import": "./dist/src/strategies.js"
    },
    "./llm": {
      "types": "./dist/src/llm.d.ts",
      "import": "./dist/src/llm.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint . --deny-warnings"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "agent-device",
    "ai",
    "selector",
    "accessibility",
    "automation",
    "mobile",
    "testing",
    "llm"
  ],
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agent-device/contracts": "workspace:*",
    "@agent-device/selectors": "workspace:*",
    "@types/node": "^22.20.1",
    "ai": "^7.0.68",
    "fast-check": "^4.9.0",
    "oxlint": "^1.79.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11"
  }
}