# agent-device-enhanced Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files — they are gitignored

# =============================================================================
# LLM Provider API Keys (for AI Selector & Screen Recording AI)
# At least one provider key is required for AI features
# =============================================================================

# OpenAI (GPT-4o, GPT-4o-mini, GPT-4-turbo)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet, Haiku, Opus)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Groq (Llama 3.3 70B, Llama 3.1 8B, Mixtral) - FREE tier available
# Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Google (Gemini 1.5 Pro, Flash, 2.0 Flash)
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=...

# =============================================================================
# Agent-Device Configuration
# =============================================================================

# Default platform (ios, android, web, macos, linux, harmonyos, tvos)
# AGENT_DEVICE_DEFAULT_PLATFORM=ios

# Daemon configuration
# AGENT_DEVICE_DAEMON_PORT=34567
# AGENT_DEVICE_DAEMON_HOST=localhost

# Session artifact directory
# AGENT_DEVICE_ARTIFACTS_DIR=.tmp/artifacts

# Screen recording output directory
# AGENT_DEVICE_RECORDINGS_DIR=.tmp/recordings

# =============================================================================
# Device Cloud Providers (for remote device testing)
# =============================================================================

# BrowserStack
# BROWSERSTACK_USERNAME=your_username
# BROWSERSTACK_ACCESS_KEY=your_access_key

# AWS Device Farm
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-west-2

# Limrun
# LIMRUN_API_KEY=...

# TestMu AI
# TESTMU_API_KEY=...

# =============================================================================
# Security Scanning Configuration
# =============================================================================

# Custom credential patterns file (JSON)
# SECURITY_CREDENTIAL_PATTERNS=./custom-credential-patterns.json

# Custom PII patterns file (JSON)
# SECURITY_PII_PATTERNS=./custom-pii-patterns.json

# Minimum severity to report (low, medium, high, critical)
# SECURITY_MIN_SEVERITY=medium

# =============================================================================
# Development / Debugging
# =============================================================================

# Enable debug logging
# DEBUG=agent-device:*

# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# Enable request/response logging for MCP
# MCP_DEBUG=false

# =============================================================================
# CI/CD Configuration (example for GitHub Actions)
# =============================================================================

# GITHUB_TOKEN=... (automatically provided in GitHub Actions)
# NPM_TOKEN=... (for publishing to npm)